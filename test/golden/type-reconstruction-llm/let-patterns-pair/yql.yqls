(
  (let print (lambda '(world rows) (block '(
    (let sink (DataSink 'result))
    (let options '('('type) '('autoref) '('unordered)))
    (let world (ResFill! world sink (Key) rows options 'pure))
    (return (Commit! world sink))))))
  (let main (lambda '(pair) (block '(
    (let yqstellamatchexpr pair)
    (let yqstellamatchbr0
      (Apply
        (lambda '(yqstellamatcharg) (block '(
          (let flag (Nth yqstellamatcharg '1))
          (let value (Nth yqstellamatcharg '0))
          (let yqstellamatchcond (And (Exists flag) (And (Exists value) (Bool 'true))))
          (let flag (Unwrap flag))
          (let value (Unwrap value))
          (return
            (If
              yqstellamatchcond
              (Just (If flag (+ value (Uint64 '1)) value))
              (Nothing (OptionalType (DataType 'Uint64))))))))
        yqstellamatchexpr))
    (return (Unwrap (Coalesce yqstellamatchbr0)))))))
  (declare __pair__ (TupleType (DataType 'Uint64) (DataType 'Bool)))
  (let result (Apply main __pair__))
  (let world (Apply print world (AsList (AsStruct '('result result)))))
  (return world)
)