(
  (let print (lambda '(world rows) (block '(
    (let sink (DataSink 'result))
    (let options '('('type) '('autoref) '('unordered)))
    (let world (ResFill! world sink (Key) rows options 'pure))
    (return (Commit! world sink))))))
  (let first_or_default (lambda '(list)
    (If
      (Not (HasItems list))
      (Unwrap (ToOptional (Skip (AsList (Uint64 '0) (Uint64 '0) (Uint64 '0)) (Uint64 '1))))
      (Unwrap (ToOptional list)))))
  (let main (lambda '(arg) (Apply first_or_default (AsList (Uint64 '0) (Uint64 '0) (Uint64 '0)))))
  (declare __arg__ (DataType 'Uint64))
  (let result (Apply main __arg__))
  (let world (Apply print world (AsList (AsStruct '('result result)))))
  (return world)
)