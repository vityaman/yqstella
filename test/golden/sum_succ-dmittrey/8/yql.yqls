(
  (let print (lambda '(world rows) (block '(
    (let sink (DataSink 'result))
    (let options '('('type) '('autoref) '('unordered)))
    (let world (ResFill! world sink (Key) rows options 'pure))
    (return (Commit! world sink))))))
  (let eval (lambda '(input) (block '(
    (let yqstellamatchexpr input)
    (let yqstellamatchbr0
      (Apply
        (lambda '(yqstellamatcharg) (block '(
          (let n (Guess yqstellamatcharg 'inl))
          (let yqstellamatchcond (And (Exists n) (Bool 'true)))
          (let n (Unwrap n))
          (return (If yqstellamatchcond (Just n) (Nothing (OptionalType (DataType 'Uint64))))))))
        yqstellamatchexpr))
    (let yqstellamatchbr1
      (Apply
        (lambda '(yqstellamatcharg) (block '(
          (let yqstellamatchtrue:7:13
            (Apply
              (lambda '(x f)
                (MatchType
                  x
                  'Optional
                  (lambda '(x) (FlatMap x (lambda '(x) (Apply f x))))
                  (lambda '(x) (Apply f x))))
              (Guess yqstellamatcharg 'inr)
              (lambda '(x) (OptionalIf x (Bool 'true)))))
          (let yqstellamatchcond (And (Exists yqstellamatchtrue:7:13) (Bool 'true)))
          (let yqstellamatchtrue:7:13 (Unwrap yqstellamatchtrue:7:13))
          (return (If yqstellamatchcond (Just (Uint64 '1)) (Nothing (OptionalType (DataType 'Uint64))))))))
        yqstellamatchexpr))
    (let yqstellamatchbr2
      (Apply
        (lambda '(yqstellamatcharg) (block '(
          (let yqstellamatchfalse:8:13
            (Apply
              (lambda '(x f)
                (MatchType
                  x
                  'Optional
                  (lambda '(x) (FlatMap x (lambda '(x) (Apply f x))))
                  (lambda '(x) (Apply f x))))
              (Guess yqstellamatcharg 'inr)
              (lambda '(x) (OptionalIf (Not x) (Bool 'false)))))
          (let yqstellamatchcond (And (Exists yqstellamatchfalse:8:13) (Bool 'true)))
          (let yqstellamatchfalse:8:13 (Unwrap yqstellamatchfalse:8:13))
          (return (If yqstellamatchcond (Just (Uint64 '0)) (Nothing (OptionalType (DataType 'Uint64))))))))
        yqstellamatchexpr))
    (return (Unwrap (Coalesce yqstellamatchbr0 yqstellamatchbr1 yqstellamatchbr2)))))))
  (let main (lambda '(n)
    (Apply
      eval
      (Variant
        (Bool 'false)
        'inr
        (VariantType (StructType '('inl (DataType 'Uint64)) '('inr (DataType 'Bool))))))))
  (declare __n__ (DataType 'Uint64))
  (let result (Apply main __n__))
  (let world (Apply print world (AsList (AsStruct '('result result)))))
  (return world)
)