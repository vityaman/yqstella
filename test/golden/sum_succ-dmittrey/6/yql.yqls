(
  (let print (lambda '(world rows) (block '(
    (let sink (DataSink 'result))
    (let options '('('type) '('autoref) '('unordered)))
    (let world (ResFill! world sink (Key) rows options 'pure))
    (return (Commit! world sink))))))
  (let doubleOrZero (lambda '(n)
    (If
      (== n (Uint64 '0))
      (Variant
        (Uint64 '0)
        'inl
        (VariantType (StructType '('inl (DataType 'Uint64)) '('inr (DataType 'Uint64)))))
      (Variant n 'inr (VariantType (StructType '('inl (DataType 'Uint64)) '('inr (DataType 'Uint64))))))))
  (let main (lambda '(n) (block '(
    (let yqstellamatchexpr (Apply doubleOrZero (+ (Uint64 '0) (Uint64 '1))))
    (let yqstellamatchbr0
      (Apply
        (lambda '(yqstellamatcharg) (block '(
          (let z (Guess yqstellamatcharg 'inl))
          (let yqstellamatchcond (And (Exists z) (Bool 'true)))
          (let z (Unwrap z))
          (return (If yqstellamatchcond (Just z) (Nothing (OptionalType (DataType 'Uint64))))))))
        yqstellamatchexpr))
    (let yqstellamatchbr1
      (Apply
        (lambda '(yqstellamatcharg) (block '(
          (let x (Guess yqstellamatcharg 'inr))
          (let yqstellamatchcond (And (Exists x) (Bool 'true)))
          (let x (Unwrap x))
          (return (If yqstellamatchcond (Just (+ x (Uint64 '1))) (Nothing (OptionalType (DataType 'Uint64))))))))
        yqstellamatchexpr))
    (return (Unwrap (Coalesce yqstellamatchbr0 yqstellamatchbr1)))))))
  (declare __n__ (DataType 'Uint64))
  (let result (Apply main __n__))
  (let world (Apply print world (AsList (AsStruct '('result result)))))
  (return world)
)