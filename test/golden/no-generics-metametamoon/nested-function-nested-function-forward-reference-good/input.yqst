language core;

extend with #nested-function-declarations;

fn main(n : Nat) -> Nat {
  fn caller(x : Nat) -> Nat {
    return callee(x)
  }
  fn callee(x : Nat) -> Nat {
    return succ(x)
  }
  return caller(n)
}