language core;
extend with #records;

fn main(x : Nat) -> Nat {
  return
    { x = { x = { x = { x = false, y = 0}
                , a = { x = 0, y = 0, z = true}}
          , y = { x = { x = false, y = 0}
                , y = { x = false, y = 0}}}
    , y = { a = { x = { x = 0, y = 0}
                , y = { x = 0, y = 0}}
          , y = { x = { a = 0, y = 0}
                , y = { x = false, y = 0}}}}.x.y.a.y
}
