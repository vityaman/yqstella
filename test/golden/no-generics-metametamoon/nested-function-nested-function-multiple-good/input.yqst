language core;

extend with #nested-function-declarations;



fn main(n : Nat) -> Nat {
  fn addTwo(x : Nat) -> Nat {
    return succ(succ(x))
  }
  fn addThree(x : Nat) -> Nat {
    return succ(succ(succ(x)))
  }
  return addTwo(addThree(n))
}