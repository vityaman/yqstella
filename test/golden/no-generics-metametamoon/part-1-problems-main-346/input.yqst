language core;
extend with #variants;

fn g(x : <| number : Nat, boolean : Bool, function : fn(Nat) -> Nat |>) -> Nat {
  return match x {
      <| number1   = n |> => succ(n)
    | <| function = f |> => f(f(succ(0)))
  }
}

fn main(x : Nat) -> Nat {
  return g(<| function = fn(n : Nat) { return g(<| number = n |>) } |>)
}
