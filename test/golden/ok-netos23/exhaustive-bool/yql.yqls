(
  (let print (lambda '(world rows) (block '(
    (let sink (DataSink 'result))
    (let options '('('type) '('autoref) '('unordered)))
    (let world (ResFill! world sink (Key) rows options 'pure))
    (return (Commit! world sink))))))
  (let main (lambda '(n) (block '(
    (let yqstellamatchexpr (Bool 'true))
    (let yqstellamatchbr0
      (Apply
        (lambda '(yqstellamatcharg) (block '(
          (let yqstellamatchtrue:7:9
            (Apply
              (lambda '(x f)
                (MatchType
                  x
                  'Optional
                  (lambda '(x) (FlatMap x (lambda '(x) (Apply f x))))
                  (lambda '(x) (Apply f x))))
              yqstellamatcharg
              (lambda '(x) (OptionalIf x (Bool 'true)))))
          (let yqstellamatchcond (And (Exists yqstellamatchtrue:7:9) (Bool 'true)))
          (let yqstellamatchtrue:7:9 (Unwrap yqstellamatchtrue:7:9))
          (return (If yqstellamatchcond (Just (Uint64 '0)) (Nothing (OptionalType (DataType 'Uint64))))))))
        yqstellamatchexpr))
    (let yqstellamatchbr1
      (Apply
        (lambda '(yqstellamatcharg) (block '(
          (let yqstellamatchfalse:8:7
            (Apply
              (lambda '(x f)
                (MatchType
                  x
                  'Optional
                  (lambda '(x) (FlatMap x (lambda '(x) (Apply f x))))
                  (lambda '(x) (Apply f x))))
              yqstellamatcharg
              (lambda '(x) (OptionalIf (Not x) (Bool 'false)))))
          (let yqstellamatchcond (And (Exists yqstellamatchfalse:8:7) (Bool 'true)))
          (let yqstellamatchfalse:8:7 (Unwrap yqstellamatchfalse:8:7))
          (return (If yqstellamatchcond (Just (Uint64 '0)) (Nothing (OptionalType (DataType 'Uint64))))))))
        yqstellamatchexpr))
    (return (Unwrap (Coalesce yqstellamatchbr0 yqstellamatchbr1)))))))
  (declare __n__ (DataType 'Uint64))
  (let result (Apply main __n__))
  (let world (Apply print world (AsList (AsStruct '('result result)))))
  (return world)
)